{
  "$schema": "../../../schemas/task-preset-plugin/task-preset.schema.json",
  "taskKey": "addCommunityTask",
  "scriptKey": "autotask.add-community-task",
  "defaultTargetType": "repository",
  "requirements": [
    { "type": "agent", "name": "any" },
    { "type": "cli", "name": "gh", "command": "gh", "args": ["--version"] },
    { "type": "cli", "name": "git", "command": "git", "args": ["--version"] },
    { "type": "cli", "name": "node", "command": "node", "args": ["--version"] }
  ],
  "targets": {
    "repositories": {
      "enabled": true,
      "selections": [
        {
          "id": "targetRepositories",
          "selectionMode": "multiple",
          "allowedAccessTypes": ["read"],
          "accessType": "read",
          "required": false,
          "output": "targetRepositories",
          "scope": { "source": "owner-project-repositories" }
        }
      ]
    },
    "vaults": {
      "enabled": true,
      "selections": [
        {
          "id": "referenceVaultIds",
          "selectionMode": "multiple",
          "accessType": "read",
          "required": false,
          "output": "referenceVaultIds",
          "scope": { "source": "vault-registry" }
        }
      ]
    },
    "projects": {
      "enabled": true,
      "selections": [
        {
          "id": "targetProjects",
          "selectionMode": "multiple",
          "allowedAccessTypes": ["read"],
          "accessType": "read",
          "required": false,
          "output": "targetProjects",
          "scope": { "source": "project-registry" }
        }
      ]
    }
  },
  "inputBindings": [
    {
      "input": "communityTaskName",
      "promptParameter": "communityTaskName",
      "metadataKey": "autoTaskCommunityTaskName",
      "required": true
    },
    {
      "input": "communityTaskObjective",
      "promptParameter": "communityTaskObjective",
      "metadataKey": "autoTaskCommunityTaskObjective",
      "required": true
    },
    {
      "input": "communityTaskInputs",
      "promptParameter": "communityTaskInputs",
      "metadataKey": "autoTaskCommunityTaskInputs",
      "required": true
    },
    {
      "input": "communityTaskQuality",
      "promptParameter": "communityTaskQuality",
      "metadataKey": "autoTaskCommunityTaskQuality",
      "required": true
    },
    {
      "input": "communityTaskAcceptance",
      "promptParameter": "communityTaskAcceptance",
      "metadataKey": "autoTaskCommunityTaskAcceptance",
      "required": true
    },
    {
      "input": "communityTaskPublication",
      "promptParameter": "communityTaskPublication",
      "metadataKey": "autoTaskCommunityTaskPublication",
      "required": false
    },
    {
      "input": "targetScopeMarkdown",
      "promptParameter": "targetScopeMarkdown",
      "metadataKey": "autoTaskTargetScopeMarkdown",
      "producer": "frontend-computed"
    }
  ]
}
